# Copiá este archivo a .env.local y completá los valores. .env.local NO se versiona.
# Las variables con prefijo VITE_ terminan dentro del JavaScript público del sitio:
# solo pueden ir datos públicos. La clave service_role NUNCA va acá ni en ningún archivo del repo.

# --- Frontend (públicas) ---
# URL del proyecto de Supabase (local: http://127.0.0.1:54321; o la del proyecto de desarrollo).
VITE_SUPABASE_URL=
# Clave pública del proyecto (anon o "publishable"). Es pública por diseño: la seguridad la da RLS.
VITE_SUPABASE_ANON_KEY=
# Número de WhatsApp de la tienda: solo dígitos, con código de país y el 9 (ej. 549XXXXXXXXXX).
VITE_WHATSAPP_NUMBER=

# --- Solo para el Supabase CLI en tu máquina (nunca con prefijo VITE_) ---
# Token personal de https://supabase.com/dashboard/account/tokens (para `supabase link` y `db push`).
SUPABASE_ACCESS_TOKEN=
# Contraseña de la base del proyecto que estés vinculando.
SUPABASE_DB_PASSWORD=
# Identificadores (project ref) de cada entorno.
SUPABASE_PROJECT_REF_DEV=
SUPABASE_PROJECT_REF_PROD=
