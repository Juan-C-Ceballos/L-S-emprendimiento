# Headers de Cloudflare Pages (etapa 8, D-41). Se copian tal cual a dist/.
# Una Content-Security-Policy queda como mejora (etapa 9): hay que listar Supabase, Google Fonts y wa.me.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Vite pone un hash en el nombre de cada archivo de /assets: nunca cambian.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
